{
  "apiVersion": 1,
  "kind": "language-pack",
  "id": "agent-k.typescript-javascript",
  "version": "1.0.0",
  "displayName": "TypeScript/JavaScript",
  "platforms": ["win32", "linux"],
  "languages": ["typescript", "typescriptreact", "javascript", "javascriptreact"],
  "fileExtensions": [".ts", ".tsx", ".js", ".jsx"],
  "projectMarkers": ["tsconfig.json", "jsconfig.json", "package.json"],
  "actions": [
    { "id": "project.list", "method": "agent", "description": "List loaded projects.", "parameters": { "type": "object" } },
    { "id": "project.load", "method": "agent", "description": "Load a project.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "project.status", "method": "agent", "description": "Get project status.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "project.restart", "method": "agent", "description": "Restart project services.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "project.unload", "method": "agent", "description": "Unload a project.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "language.diagnostics", "method": "agent", "description": "Read diagnostics.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "language.definition", "method": "agent", "description": "Find a definition.", "parameters": { "type": "object", "required": ["workspace", "file", "position"] } },
    { "id": "language.references", "method": "agent", "description": "Find references.", "parameters": { "type": "object", "required": ["workspace", "file", "position"] } },
    { "id": "language.hover", "method": "agent", "description": "Get hover information.", "parameters": { "type": "object", "required": ["workspace", "file", "position"] } },
    { "id": "language.symbols", "method": "agent", "description": "Find symbols.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "language.completion", "method": "agent", "description": "Get completions.", "parameters": { "type": "object", "required": ["workspace", "file", "position"] } },
    { "id": "language.rename", "method": "agent", "description": "Rename a symbol.", "parameters": { "type": "object", "required": ["workspace", "file", "position", "newName"] } },
    { "id": "language.format", "method": "agent", "description": "Format a document.", "parameters": { "type": "object", "required": ["workspace", "file"] } },
    { "id": "language.organize-imports", "method": "agent", "description": "Organize imports.", "parameters": { "type": "object", "required": ["workspace", "file"] } },
    { "id": "build", "method": "agent", "description": "Build the package.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "run", "method": "agent", "description": "Run the package.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "test", "method": "agent", "description": "Test the package.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "debug.configurations", "method": "agent", "description": "List JavaScript debug targets.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "debug.start", "method": "agent", "description": "Start a JavaScript DAP session.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "debug.attach", "method": "agent", "description": "Attach to a Node.js process.", "parameters": { "type": "object", "required": ["workspace", "processId"] } },
    { "id": "debug.stop", "method": "agent", "description": "Stop a JavaScript DAP session.", "parameters": { "type": "object", "required": ["sessionId"] } }
  ],
  "permissions": { "externalTools": ["node", "npm", "typescript", "typescript-language-server", "js-debug", "tar", "gzip", "xz", "tasklist", "ps"], "network": true, "processes": true, "workspaceWrite": true },
  "toolchains": [{ "id": "node", "system": { "commands": ["node"], "versionRange": ">=24.18.1 <25" }, "fallback": { "version": "24.18.1", "platforms": { "win32": { "url": "https://nodejs.org/dist/v24.18.1/node-v24.18.1-win-x64.zip", "sha256": "ec56b84a7551893ab2324ebdfdc4ab974a63b4781162600b68a1293cc3e53765" }, "linux": { "url": "https://nodejs.org/dist/v24.18.1/node-v24.18.1-linux-x64.tar.xz", "sha256": "d6c664df3f3f61458e8c277585571328522d705166723a7c7823a9253a4d15a0" } } } }, { "id": "npm", "system": { "commands": ["npm"], "versionRange": ">=11 <12" } }, { "id": "js-debug", "fallback": { "version": "1.117.0", "platforms": { "win32": { "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.117.0/js-debug-dap-v1.117.0.tar.gz", "sha256": "ad8d04ede9d4b75cc290fd5438a65047a06f786d04f604b6112485b36f090772" }, "linux": { "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.117.0/js-debug-dap-v1.117.0.tar.gz", "sha256": "ad8d04ede9d4b75cc290fd5438a65047a06f786d04f604b6112485b36f090772" } } } }],
  "projectMenu": { "loadLabel": "Load TypeScript/JavaScript project", "unloadLabel": "Unload TypeScript/JavaScript project", "actions": [{ "id": "build", "label": "Build", "method": "agent" }, { "id": "test", "label": "Test", "method": "agent" }] },
  "editorContribution": { "id": "typescript-javascript-project", "name": "TypeScript/JavaScript project", "description": "Text editing, TypeScript semantics and package lifecycle.", "version": "1.0.0", "editorPluginId": "agent-k.text" },
  "skills": [{ "name": "typescript-javascript-tools", "markdown": "---\nname: typescript-javascript-tools\ndescription: Use the installed TypeScript/JavaScript Language Pack for project, semantic, build, run, and test work.\n---\n\n# TypeScript/JavaScript Language Pack\n\nCall `agent_k` with capability `language`, packId `agent-k.typescript-javascript`, and a declared standard action. Call `project.status` first and pass only workspace-relative paths.\n" }],
  "commands": [{ "id": "active-typescript-projects", "title": "Active TypeScript/JavaScript projects", "kind": "project-manager" }],
  "worker": "dist/worker.js",
  "debugServer": { "protocol": "dap", "prepareMethod": "debugPrepare", "providers": [{ "id": "javascript-node", "label": "JavaScript/TypeScript (Node.js)", "languages": ["typescript", "typescriptreact", "javascript", "javascriptreact"], "fileExtensions": [".ts", ".tsx", ".js", ".jsx"], "projectMarkers": ["tsconfig.json", "jsconfig.json", "package.json"], "modes": ["launch", "attach"], "priority": 100 }], "adapters": [{ "command": "js-debug", "platforms": ["win32", "linux"] }] }
}
