{
  "apiVersion": 1,
  "kind": "language-pack",
  "id": "agent-k.cpp",
  "version": "1.0.0",
  "displayName": "C/C++",
  "platforms": ["win32", "linux"],
  "languages": ["c", "cpp"],
  "fileExtensions": [".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx"],
  "projectMarkers": ["CMakeLists.txt", "compile_commands.json"],
  "actions": [
    { "id": "project.list", "method": "agent", "description": "List loaded projects.", "parameters": { "type": "object" } },
    { "id": "project.load", "method": "agent", "description": "Load a project.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" } }, "required": ["workspace"] } },
    { "id": "project.status", "method": "agent", "description": "Get project status.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" } }, "required": ["workspace"] } },
    { "id": "project.restart", "method": "agent", "description": "Restart project services.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" } }, "required": ["workspace"] } },
    { "id": "project.unload", "method": "agent", "description": "Unload a project.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" } }, "required": ["workspace"] } },
    { "id": "language.diagnostics", "method": "agent", "description": "Read diagnostics.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" } }, "required": ["workspace"] } },
    { "id": "language.definition", "method": "agent", "description": "Find a definition.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "file": { "type": "string" }, "position": { "type": "object" } }, "required": ["workspace", "file", "position"] } },
    { "id": "language.references", "method": "agent", "description": "Find references.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "file": { "type": "string" }, "position": { "type": "object" } }, "required": ["workspace", "file", "position"] } },
    { "id": "language.hover", "method": "agent", "description": "Get hover information.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "file": { "type": "string" }, "position": { "type": "object" } }, "required": ["workspace", "file", "position"] } },
    { "id": "language.symbols", "method": "agent", "description": "Find document or workspace symbols.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "file": { "type": "string" }, "query": { "type": "string" } }, "required": ["workspace"] } },
    { "id": "language.completion", "method": "agent", "description": "Get completions.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "file": { "type": "string" }, "position": { "type": "object" } }, "required": ["workspace", "file", "position"] } },
    { "id": "language.rename", "method": "agent", "description": "Rename a symbol.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "file": { "type": "string" }, "position": { "type": "object" }, "newName": { "type": "string" } }, "required": ["workspace", "file", "position", "newName"] } },
    { "id": "language.format", "method": "agent", "description": "Format a document.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "file": { "type": "string" } }, "required": ["workspace", "file"] } },
    { "id": "build", "method": "agent", "description": "Build the project.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "configuration": { "type": "string" } }, "required": ["workspace"] } },
    { "id": "run", "method": "agent", "description": "Run a built target.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "configuration": { "type": "string" }, "program": { "type": "string" }, "args": { "type": "array" } }, "required": ["workspace", "program"] } },
    { "id": "test", "method": "agent", "description": "Run project tests.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "configuration": { "type": "string" } }, "required": ["workspace"] } },
    { "id": "debug.configurations", "method": "agent", "description": "List debug configurations.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "file": { "type": "string" }, "refresh": { "type": "boolean" }, "configuration": { "type": "string" } }, "required": ["workspace"] } },
    { "id": "debug.start", "method": "agent", "description": "Start debugging.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "program": { "type": "string" }, "args": { "type": "array" } }, "required": ["workspace"] } },
    { "id": "debug.attach", "method": "agent", "description": "Attach the debugger.", "parameters": { "type": "object", "properties": { "workspace": { "type": "string" }, "processId": { "type": "integer" } }, "required": ["workspace", "processId"] } },
    { "id": "debug.stop", "method": "agent", "description": "Stop debugging.", "parameters": { "type": "object", "properties": { "sessionId": { "type": "string" } }, "required": ["sessionId"] } }
  ],
  "permissions": { "externalTools": ["cmake", "ninja", "clangd", "clang", "compiler-windows", "compiler-linux", "codelldb", "tar", "gzip", "xz", "tasklist", "ps"], "network": true, "processes": true, "workspaceWrite": false },
  "toolchains": [
    { "id": "cmake", "system": { "commands": ["cmake"], "versionRange": ">=3.20 <4" }, "fallback": { "version": "3.31.6", "platforms": { "win32": { "url": "https://github.com/Kitware/CMake/releases/download/v3.31.6/cmake-3.31.6-windows-x86_64.zip", "sha256": "d163cd3ab4959b0a53fa8988f2ddbd2e6c501658201e6a154386bad9dbe4f836" }, "linux": { "url": "https://github.com/Kitware/CMake/releases/download/v3.31.6/cmake-3.31.6-linux-x86_64.tar.gz", "sha256": "5a1133ff103c71eb5120e2cc3de922733e7d8a26a98ae716397e8676adb367bf" } } } },
    { "id": "ninja", "system": { "commands": ["ninja"], "versionRange": ">=1.10 <2" }, "fallback": { "version": "1.12.1", "platforms": { "win32": { "url": "https://github.com/ninja-build/ninja/releases/download/v1.12.1/ninja-win.zip", "sha256": "f550fec705b6d6ff58f2db3c374c2277a37691678d6aba463adcbb129108467a" }, "linux": { "url": "https://github.com/ninja-build/ninja/releases/download/v1.12.1/ninja-linux.zip", "sha256": "6f98805688d19672bd699fbbfa2c2cf0fc054ac3df1f0e6a47664d963d530255" } } } },
    { "id": "clangd", "system": { "commands": ["clangd"], "versionRange": ">=22.1.6 <23" }, "fallback": { "version": "22.1.6", "platforms": { "win32": { "url": "https://github.com/clangd/clangd/releases/download/22.1.6/clangd-windows-22.1.6.zip", "sha256": "ce54f16e0b4fd76d450eeda9664420b195360b73febcfe40e661108fa57f2ce1" }, "linux": { "url": "https://github.com/clangd/clangd/releases/download/22.1.6/clangd-linux-22.1.6.zip", "sha256": "a9c77443af2e447ed467e84771848d3a6ac1c56f84bcfcde717e66318de77cfa" } } } },
    { "id": "compiler-windows", "system": { "commands": ["clang++", "clang"], "versionRange": ">=18 <23" }, "fallback": { "version": "20260616", "platforms": { "win32": { "url": "https://github.com/mstorsjo/llvm-mingw/releases/download/20260616/llvm-mingw-20260616-ucrt-x86_64.zip", "sha256": "b9b68a4d276e16fa25802aaba458e4638f64b3884c290aaccdc2d87083b6ca35" } } } },
    { "id": "compiler-linux", "system": { "commands": ["clang++", "g++"], "versionRange": ">=13 <23" }, "fallback": { "version": "22.1.8", "platforms": { "linux": { "url": "https://github.com/llvm/llvm-project/releases/download/llvmorg-22.1.8/LLVM-22.1.8-Linux-X64.tar.xz", "sha256": "df0e1ecf16caf3489a272a5eea4eec9b0d82878f6477fa309504f918a0006384" } } } },
    { "id": "codelldb", "system": { "commands": ["codelldb"], "versionRange": ">=1.12.2 <2" }, "fallback": { "version": "1.12.2", "platforms": { "win32": { "url": "https://github.com/vadimcn/codelldb/releases/download/v1.12.2/codelldb-win32-x64.vsix", "sha256": "aa3f45175da3850973632fef1a1af0ed2382866bfd3dcd836544973831388a25" }, "linux": { "url": "https://github.com/vadimcn/codelldb/releases/download/v1.12.2/codelldb-linux-x64.vsix", "sha256": "b85b45a8570051d535b0927c6c9da11c39f3a056c73559064647faf7f37f637d" } } } }
  ],
  "projectMenu": { "loadLabel": "Load C/C++ project", "unloadLabel": "Unload C/C++ project", "actions": [{ "id": "build", "label": "Build", "method": "agent", "defaultProfile": "Debug", "profiles": [{ "id": "Debug", "label": "Debug" }, { "id": "Release", "label": "Release" }] }] },
  "editorContribution": { "id": "cpp-project", "name": "C/C++ project", "description": "Text editing, clangd semantics and native debugging.", "version": "1.0.0", "editorPluginId": "agent-k.text" },
  "skills": [{ "name": "cpp-project-tools", "markdown": "---\nname: cpp-project-tools\ndescription: Use the installed C/C++ Language Pack for project, semantic, build, run, test, and debug work.\n---\n\n# C/C++ Language Pack\n\nCall `agent_k` with capability `language`, packId `agent-k.cpp`, and one of these exact action IDs: `project.list`, `project.load`, `project.status`, `project.restart`, `project.unload`, `language.diagnostics`, `language.definition`, `language.references`, `language.hover`, `language.symbols`, `language.completion`, `language.rename`, `language.format`, `build`, `run`, `test`, `debug.configurations`, `debug.start`, `debug.attach`, or `debug.stop`. Never shorten or rename an action: use `language.symbols`, not `symbols`; use `language.hover`, not `hover` or `semantic.hover`. Put action-specific values in `arguments`. Call `project.status` before semantic, build, run, test, or debug actions. Pass `workspace` and `file` as workspace-relative paths. Semantic positions are zero-based `{ line: number, character: number }` objects.\n" }],
  "commands": [{ "id": "active-cpp-projects", "title": "Active C/C++ projects", "kind": "project-manager" }],
  "worker": "dist/worker.js",
  "debugServer": { "protocol": "dap", "prepareMethod": "debugPrepare", "providers": [{ "id": "cpp-native", "label": "C/C++ Native", "languages": ["c", "cpp"], "fileExtensions": [".c", ".cc", ".cpp", ".cxx", ".h", ".hpp"], "projectMarkers": ["CMakeLists.txt", "compile_commands.json"], "modes": ["launch", "attach", "dump"], "priority": 100 }], "adapters": [{ "command": "codelldb", "platforms": ["win32", "linux"] }] }
}
