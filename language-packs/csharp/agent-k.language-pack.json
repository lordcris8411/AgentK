{
  "apiVersion": 1,
  "kind": "language-pack",
  "id": "agent-k.csharp",
  "version": "1.0.0",
  "displayName": "C#",
  "platforms": ["win32", "linux"],
  "languages": ["csharp"],
  "fileExtensions": [".cs", ".csproj", ".sln"],
  "projectMarkers": ["*.sln", "*.csproj"],
  "actions": [
    { "id": "project.list", "method": "agent", "description": "List loaded projects.", "parameters": { "type": "object" } },
    { "id": "project.load", "method": "agent", "description": "Load a project.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "project.status", "method": "agent", "description": "Get project status.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "project.restart", "method": "agent", "description": "Restart project services.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "project.unload", "method": "agent", "description": "Unload a project.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "language.diagnostics", "method": "agent", "description": "Read diagnostics.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "language.definition", "method": "agent", "description": "Find a definition.", "parameters": { "type": "object", "required": ["workspace", "file", "position"] } },
    { "id": "language.references", "method": "agent", "description": "Find references.", "parameters": { "type": "object", "required": ["workspace", "file", "position"] } },
    { "id": "language.hover", "method": "agent", "description": "Get hover information.", "parameters": { "type": "object", "required": ["workspace", "file", "position"] } },
    { "id": "language.symbols", "method": "agent", "description": "Find symbols.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "language.completion", "method": "agent", "description": "Get completions.", "parameters": { "type": "object", "required": ["workspace", "file", "position"] } },
    { "id": "language.rename", "method": "agent", "description": "Rename a symbol.", "parameters": { "type": "object", "required": ["workspace", "file", "position", "newName"] } },
    { "id": "language.format", "method": "agent", "description": "Format a document.", "parameters": { "type": "object", "required": ["workspace", "file"] } },
    { "id": "build", "method": "agent", "description": "Build with isolated dotnet.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "run", "method": "agent", "description": "Run with isolated dotnet.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "test", "method": "agent", "description": "Test with isolated dotnet.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "debug.configurations", "method": "agent", "description": "List private .NET debug targets.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "debug.start", "method": "agent", "description": "Start a .NET DAP session.", "parameters": { "type": "object", "required": ["workspace"] } },
    { "id": "debug.attach", "method": "agent", "description": "Attach netcoredbg to a process.", "parameters": { "type": "object", "required": ["workspace", "processId"] } },
    { "id": "debug.stop", "method": "agent", "description": "Stop a .NET DAP session.", "parameters": { "type": "object", "required": ["sessionId"] } }
  ],
  "permissions": { "externalTools": ["dotnet", "csharp-ls", "netcoredbg", "tar", "gzip", "tasklist", "ps"], "network": true, "processes": true, "workspaceWrite": false },
  "toolchains": [
    { "id": "dotnet", "system": { "commands": ["dotnet"], "versionRange": ">=10.0.302 <11" }, "fallback": { "version": "10.0.302", "platforms": { "win32": { "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.302/dotnet-sdk-10.0.302-win-x64.zip", "sha512": "7d170ed75fa9af34c00646621d92011dbd71943952e2787cd15df9be78e6452b55dadef34d7eff77b802e6af4959e071a55855ac649afeac70901c3a2a258716" }, "linux": { "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.302/dotnet-sdk-10.0.302-linux-x64.tar.gz", "sha512": "10069bec8783596484a610332f090d562802a41b9b40e3327a5a5688b572e10c296ae300f940d40461f23c157ed1b0843c2f8e6b3f20d8d8d9d83432d8143bac" } } } },
    { "id": "csharp-ls", "fallback": { "version": "0.26.0", "platforms": { "win32": { "url": "https://www.nuget.org/api/v2/package/csharp-ls/0.26.0", "sha256": "2b03987aef07bb708bfe56a7bfb370364c7c8203e69aa677a37594bbe21a15b0" }, "linux": { "url": "https://www.nuget.org/api/v2/package/csharp-ls/0.26.0", "sha256": "2b03987aef07bb708bfe56a7bfb370364c7c8203e69aa677a37594bbe21a15b0" } } } },
    { "id": "netcoredbg", "fallback": { "version": "3.2.0-1092", "platforms": { "win32": { "url": "https://github.com/Samsung/netcoredbg/releases/download/3.2.0-1092/netcoredbg-win64.zip", "sha256": "3c410a45fa502415203a94fcb88654af65bf8e3dac158a5527a722e7a6b9274a" }, "linux": { "url": "https://github.com/Samsung/netcoredbg/releases/download/3.2.0-1092/netcoredbg-linux-amd64.tar.gz", "sha256": "080eb3b2d2152465f599d3b33d1ee6e747794e11cc0a3773ec689f5e5f2c5afa" } } } }
  ],
  "projectMenu": { "loadLabel": "Load C# project", "unloadLabel": "Unload C# project", "actions": [{ "id": "build", "label": "Build", "method": "agent" }] },
  "editorContribution": { "id": "csharp-project", "name": "C# project", "description": "Text editing, C# semantics and .NET lifecycle.", "version": "1.0.0", "editorPluginId": "agent-k.text" },
  "skills": [{ "name": "csharp-project-tools", "markdown": "---\nname: csharp-project-tools\ndescription: Use the installed C# Language Pack for project, semantic, build, run, and test work.\n---\n\n# C# Language Pack\n\nCall `agent_k` with capability `language`, packId `agent-k.csharp`, and a declared standard action. Call `project.status` first and pass only workspace-relative paths.\n" }],
  "commands": [{ "id": "active-csharp-projects", "title": "Active C# projects", "kind": "project-manager" }],
  "worker": "dist/worker.js",
  "debugServer": { "protocol": "dap", "prepareMethod": "debugPrepare", "providers": [{ "id": "csharp-coreclr", "label": "C# (.NET)", "languages": ["csharp"], "fileExtensions": [".cs", ".csproj", ".sln"], "projectMarkers": ["*.sln", "*.csproj"], "modes": ["launch", "attach"], "priority": 100 }], "adapters": [{ "command": "netcoredbg", "platforms": ["win32", "linux"] }] }
}
